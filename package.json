{
  "name": "@alexify/syncom",
  "version": "0.0.1",
  "description": "Fast, zero-dependency distributed data sync engine",
  "main": "index.js",
  "browser": {
    "./index.js": "./browser.js",
    "./src/index.js": "./src/index.browser.js",
    "./src/crypto.js": "./src/crypto.browser.js",
    "./src/fsi.js": "./src/fsi.browser.js",
    "./src/utils.js": "./src/utils.browser.js"
  },
  "types": "index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./browser.d.ts",
        "default": "./browser.js"
      },
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./wrpc": {
      "types": "./wrpc.d.ts",
      "default": "./wrpc.js"
    },
    "./contracts": {
      "types": "./contracts.d.ts",
      "default": "./contracts.js"
    },
    "./idb": {
      "types": "./idb.d.ts",
      "default": "./idb.js"
    },
    "./package.json": "./package.json"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "c8 --all --include 'src/**' --check-coverage --lines 95 --statements 95 --branches 90 --functions 95 --reporter text --reporter lcov node --test",
    "test:types": "tsd",
    "bench": "node bench/run-all.js",
    "lint": "oxlint src tests scripts bench",
    "format": "oxfmt src tests scripts bench",
    "format:check": "oxfmt --check src tests scripts bench",
    "size": "node scripts/size.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "tsd": {
    "directory": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexis-Technologies/syncom.git"
  },
  "keywords": [
    "syncom",
    "distributed",
    "data",
    "sync",
    "engine",
    "real-time",
    "collaboration",
    "p2p",
    "peer-to-peer",
    "replication",
    "wrpc",
    "websocket",
    "conflict-resolution",
    "CRDT",
    "event-sourcing",
    "blockchain",
    "smart-contracts",
    "local-first",
    "offline-first",
    "storage",
    "database",
    "zero-dependency",
    "javascript",
    "nodejs",
    "browser",
    "indexeddb",
    "opentelemetry",
    "observability"
  ],
  "author": "Alex Dolid <dolid.sasha@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Alexis-Technologies/syncom/issues"
  },
  "homepage": "https://syncomjs.vercel.app/",
  "devDependencies": {
    "@alexify/metaschema": "^3.4.0",
    "@alexify/wrpc": "1.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^22.10.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "c8": "^10.1.3",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.6",
    "mermaid": "^11.16.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "pino": "^10.3.1",
    "tsd": "^0.33.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5",
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js",
    "browser.d.ts",
    "wrpc.js",
    "wrpc.d.ts",
    "contracts.js",
    "contracts.d.ts",
    "idb.js",
    "idb.d.ts",
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "package.json"
  ]
}
