{
  "name": "@alexify/syncom",
  "version": "0.0.1",
  "description": "Fast, zero-dependency distributed data sync engine",
  "main": "index.js",
  "browser": {
    "./index.js": "./browser.js",
    "./src/runtime/node.js": "./src/runtime/browser.js"
  },
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "default": "./index.js"
    }
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "c8 --all --include 'src/**' --check-coverage --lines 95 --statements 95 --branches 90 --functions 95 --reporter text --reporter lcov node --test tests/*.test.js",
    "test:types": "tsd",
    "bench": "node bench/bench.js",
    "lint": "oxlint src tests scripts bench",
    "format": "oxfmt src tests scripts bench",
    "format:check": "oxfmt --check src tests scripts bench",
    "size": "node scripts/size.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "bench:compare": "node bench/compare.js",
    "size:compare": "node scripts/size-compare.js"
  },
  "tsd": {
    "directory": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexis-Technologies/syncom.git"
  },
  "keywords": [
    "syncom",
    "distributed",
    "data",
    "sync",
    "engine",
    "real-time",
    "collaboration",
    "p2p",
    "peer-to-peer",
    "replication",
    "conflict-resolution",
    "CRDT",
    "event-sourcing",
    "database",
    "globalstorage",
    "localstorage",
    "storage",
    "global",
    "warehouse",
    "distributed"
  ],
  "author": "Alex Dolid <dolid.sasha@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Alexis-Technologies/syncom/issues"
  },
  "homepage": "https://syncomjs.vercel.app/",
  "devDependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "c8": "^10.1.3",
    "esbuild": "^0.28.1",
    "mermaid": "^11.16.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "pino": "^10.3.1",
    "tsd": "^0.31.2",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5",
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js",
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "package.json"
  ]
}
