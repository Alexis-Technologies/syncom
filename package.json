{
  "name": "@alexify/syncom",
  "version": "0.0.1",
  "description": "Fast, zero-dependency distributed data sync engine",
  "main": "index.js",
  "browser": {
    "./index.js": "./browser.js",
    "./src/index.js": "./src/index.browser.js",
    "./src/fsi.js": "./src/fsi.browser.js",
    "./src/utils.js": "./src/utils.browser.js",
    "./src/signing/ed25519.js": "./src/signing/ed25519.browser.js",
    "./src/encryption/rsa.js": "./src/encryption/rsa.browser.js"
  },
  "types": "index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./browser.d.ts",
        "default": "./browser.js"
      },
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./wrpc": {
      "types": "./src/wrpc/wrpc.d.ts",
      "default": "./src/wrpc/wrpc.js"
    },
    "./contracts": {
      "types": "./src/contracts/contracts.d.ts",
      "default": "./src/contracts/contracts.js"
    },
    "./idb": {
      "types": "./src/idb/idb.d.ts",
      "default": "./src/idb/idb.js"
    },
    "./search": {
      "types": "./src/search/search.d.ts",
      "default": "./src/search/search.js"
    },
    "./order": {
      "types": "./src/order/order.d.ts",
      "default": "./src/order/order.js"
    },
    "./undo": {
      "types": "./src/undo/undo.d.ts",
      "default": "./src/undo/undo.js"
    },
    "./branch": {
      "types": "./src/branch/branch.d.ts",
      "default": "./src/branch/branch.js"
    },
    "./all": {
      "types": "./src/all/all.d.ts",
      "default": "./src/all/all.js"
    },
    "./text": {
      "types": "./src/text/text.d.ts",
      "default": "./src/text/text.js"
    },
    "./tree": {
      "types": "./src/tree/tree.d.ts",
      "default": "./src/tree/tree.js"
    },
    "./signing": {
      "browser": {
        "types": "./src/signing/signing.browser.d.ts",
        "default": "./src/signing/signing.js"
      },
      "types": "./src/signing/signing.d.ts",
      "default": "./src/signing/signing.js"
    },
    "./chain": {
      "types": "./src/chain/chain.d.ts",
      "default": "./src/chain/chain.js"
    },
    "./encryption": {
      "browser": {
        "types": "./src/encryption/encryption.browser.d.ts",
        "default": "./src/encryption/encryption.js"
      },
      "types": "./src/encryption/encryption.d.ts",
      "default": "./src/encryption/encryption.js"
    },
    "./memory": {
      "types": "./src/memory/memory.d.ts",
      "default": "./src/memory/memory.js"
    },
    "./layered": {
      "types": "./src/layered/layered.d.ts",
      "default": "./src/layered/layered.js"
    },
    "./sync": {
      "types": "./src/sync/sync.d.ts",
      "default": "./src/sync/sync.js"
    },
    "./schema": {
      "types": "./src/schema/schema.d.ts",
      "default": "./src/schema/schema.js"
    },
    "./package.json": "./package.json"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "c8 --all --include 'src/**' --check-coverage --lines 95 --statements 95 --branches 90 --functions 95 --reporter text --reporter lcov node --test",
    "test:types": "tsd",
    "bench": "node bench/run-all.js",
    "bench:compare:install": "pnpm --dir bench/compare install --ignore-workspace",
    "bench:compare": "node bench/compare.js",
    "bench:size": "node bench/compare/size.js",
    "bench:report": "node bench/report.js",
    "lint": "oxlint src tests scripts bench examples",
    "format": "oxfmt src tests scripts bench examples",
    "format:check": "oxfmt --check src tests scripts bench examples",
    "size": "node scripts/size.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:comparison": "node scripts/comparison.js"
  },
  "tsd": {
    "directory": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexis-Technologies/syncom.git"
  },
  "keywords": [
    "syncom",
    "distributed",
    "data",
    "sync",
    "engine",
    "real-time",
    "collaboration",
    "p2p",
    "peer-to-peer",
    "replication",
    "wrpc",
    "websocket",
    "webrtc",
    "conflict-resolution",
    "CRDT",
    "event-sourcing",
    "blockchain",
    "smart-contracts",
    "local-first",
    "offline-first",
    "storage",
    "database",
    "query",
    "full-text-search",
    "collaborative-text",
    "rich-text",
    "fractional-index",
    "undo",
    "branches",
    "schema",
    "migrations",
    "standard-schema",
    "zero-dependency",
    "javascript",
    "nodejs",
    "browser",
    "indexeddb",
    "opentelemetry",
    "observability"
  ],
  "author": "Alex Dolid <dolid.sasha@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Alexis-Technologies/syncom/issues"
  },
  "homepage": "https://syncomjs.vercel.app/",
  "devDependencies": {
    "@alexify/metaschema": "^3.4.0",
    "@alexify/wrpc": "2.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^22.10.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "c8": "^10.1.3",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.6",
    "mermaid": "^11.16.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "pino": "^10.3.1",
    "tsd": "^0.33.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5",
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js",
    "browser.d.ts",
    "src/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "package.json"
  ]
}
